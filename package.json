{
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "description": "RepoRadar — evidence-based repository intelligence for GitHub. Chromium MV3 extension, local-first, no backend in V1.",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "name": "reporadar",
  "private": true,
  "scripts": {
    "build": "wxt build",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
